<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Halo lembut di belakang chevron (pengganti glow) -->
    <path
        android:pathData="M32,36 L52,54 L32,72"
        android:strokeColor="#3338BDF8"
        android:strokeWidth="14"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- Chevron prompt dengan gradasi biru ke hijau -->
    <path
        android:pathData="M32,36 L52,54 L32,72"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="32" android:startY="36"
                android:endX="52" android:endY="72"
                android:startColor="#38BDF8"
                android:endColor="#34D399" />
        </aapt:attr>
    </path>
    <!-- Kursor -->
    <path
        android:pathData="M58,72 L78,72"
        android:strokeColor="#34D399"
        android:strokeWidth="8"
        android:strokeLineCap="round" />
</vector>
